@inherits LayoutComponentBase
@implements IDisposable
@inject EventosFavoa Eventos
@inject IFavoaServico Servico

<div class="app">
    <header class="topo">
        <a class="marca" href="/" aria-label="Fávoa, início">
            <Logo Tamanho="30" />
            <span>fávoa</span>
        </a>

        <nav class="navegacao" aria-label="Seções">
            <NavLink class="navegacao__item" href="" Match="NavLinkMatch.All">Hoje</NavLink>
            <NavLink class="navegacao__item" href="financas">Finanças</NavLink>
            <NavLink class="navegacao__item" href="tarefas">Tarefas</NavLink>
            <NavLink class="navegacao__item" href="habitos">Hábitos</NavLink>
            <NavFitness />
            <NavLink class="navegacao__item" href="projetos">Projetos</NavLink>
            <NavLink class="navegacao__item" href="diario">Diário</NavLink>
        </nav>

        <button type="button" class="topo__captura" aria-label="Abrir captura universal" @onclick="Eventos.SolicitarCaptura">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            <span class="topo__captura-texto">O que aconteceu? Ex.: uber 23</span>
            <span class="atalho" aria-hidden="true"><kbd>Ctrl</kbd><kbd>K</kbd></span>
        </button>

        <div class="topo__fim">
            <span class="topo__data">@DataExtenso</span>
            <PessoaTopo />
            <NavLink class="botao-icone topo__dados" href="cadastros" aria-label="Contas e categorias: categorias, contas, contas fixas e lembretes" title="Contas e categorias">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /></svg>
            </NavLink>
            <NavLink class="botao-icone topo__dados" href="dados" aria-label="Seus dados: backup, exportar e importar" title="Seus dados">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="3" /><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6" /><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" /></svg>
            </NavLink>
        </div>
    </header>

    @Body
</div>

<Captura />
<EdicaoRegistro />
<BarraCelular />

@if (_mensagem is not null)
{
    <div class="aviso" role="status" aria-live="polite">
        <span>@_mensagem</span>
        @if (_desfazer is not null)
        {
            <button type="button" class="aviso__acao" @onclick="Desfazer">Desfazer</button>
        }
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    Algo deu errado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss" aria-label="Fechar">×</span>
</div>

@code {
    private string? _mensagem;
    private Favoa.Core.Edicao.ReferenciaRegistro? _desfazer;
    private CancellationTokenSource? _cts;

    private static string DataExtenso
    {
        get
        {
            var texto = DateTime.Now.ToString("dddd, d 'de' MMMM");
            return char.ToUpper(texto[0]) + texto[1..];
        }
    }

    protected override void OnInitialized() => Eventos.Mensagem += Mostrar;

    private void Mostrar(string texto, Favoa.Core.Edicao.ReferenciaRegistro? desfazer)
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        _mensagem = texto;
        _desfazer = desfazer;
        _ = InvokeAsync(StateHasChanged);

        // Com "Desfazer" o aviso fica um pouco mais na tela.
        var duracao = desfazer is null ? 5000 : 12000;
        _ = Task.Delay(duracao, token).ContinueWith(_ =>
        {
            if (token.IsCancellationRequested) return;
            _mensagem = null;
            _desfazer = null;
            InvokeAsync(StateHasChanged);
        }, TaskScheduler.Default);
    }

    private async Task Desfazer()
    {
        if (_desfazer is not { } referencia) return;
        _desfazer = null;

        var resultado = await Servico.DesfazerAsync(referencia);
        await Eventos.NotificarRegistroSalvoAsync();
        Mostrar(resultado.Mensagem, null);
    }

    public void Dispose()
    {
        Eventos.Mensagem -= Mostrar;
        _cts?.Cancel();
    }
}
