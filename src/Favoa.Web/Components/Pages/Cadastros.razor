@page "/cadastros"
@inject NavigationManager Nav

<PageTitle>Cadastros · Fávoa</PageTitle>

<main class="modulo modulo--largo cadastros">
    <header class="pagina__topo">
        <div class="pagina__titulo">
            <h1>Cadastros</h1>
        </div>
        <nav class="segmento cadastros__abas" aria-label="Seções dos cadastros">
            @foreach (var (chave, rotulo) in Abas)
            {
                <a class="segmento__opcao @(Aba == chave ? "segmento__opcao--ativa" : "")" aria-current="@(Aba == chave ? "page" : null)"
                   href="@Nav.GetUriWithQueryParameter("aba", chave == "categorias" ? null : chave)">@rotulo</a>
            }
        </nav>
    </header>

    @switch (Aba)
    {
        case "contas": <CadastroContas />; break;
        case "recorrentes": <CadastroRecorrencias />; break;
        case "lembretes": <CadastroLembretes />; break;
        default: <CadastroCategorias />; break;
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "aba")] public string? AbaQuery { get; set; }

    private static readonly (string Chave, string Rotulo)[] Abas =
        [("categorias", "Categorias"), ("contas", "Contas"), ("recorrentes", "Recorrentes"), ("lembretes", "Lembretes")];

    private string Aba => Abas.Any(a => a.Chave == AbaQuery) ? AbaQuery! : "categorias";
}
