    private async Task Notificar(Favoa.Core.ResultadoRegistro r)
    {
        Eventos.MostrarMensagem(r.Mensagem, r.Sucesso ? r.Criado : null);
        if (r.Sucesso) await Eventos.NotificarRegistroSalvoAsync();
    }

    private async Task AdicionarConsumo(Refeicao refeicao, (AlimentoResumo Alimento, int Gramas) x) =>
        await Notificar(await Fitness.AdicionarConsumoAsync(_data, refeicao, x.Alimento.Id, x.Gramas));

    private async Task RemoverConsumo(Guid id) => await Notificar(await Fitness.RemoverConsumoAsync(id));

    private async Task SeguirPlano(Refeicao refeicao) => await Notificar(await Fitness.SeguirPlanoAsync(_data, refeicao));

    private async Task AdicionarAoPlano(Refeicao refeicao, (AlimentoResumo Alimento, int Gramas) x) =>
        await Notificar(await Fitness.AdicionarItemPlanoAsync(refeicao, x.Alimento.Id, x.Gramas));

    private async Task RemoverDoPlano(Guid id) => await Notificar(await Fitness.RemoverItemPlanoAsync(id));

    private async Task RegistrarPeso()
    {
        if (_pesoHoje is not { } kg) return;
        var r = await Fitness.RegistrarPesoAsync(_data, kg);
        if (r.Sucesso) { _pesoHoje = null; _pesoAberto = false; }
        await Notificar(r);
    }

    private async Task AoTeclarPeso(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RegistrarPeso();
    }

    private async Task SalvarAlimento()
    {
        var r = await Fitness.SalvarAlimentoAsync(new AlimentoEdicao(null, _novo.Nome, _novo.Kcal, _novo.Proteina, _novo.Carboidrato, _novo.Gordura, _novo.NomePorcao, _novo.GramasPorcao));
        if (!r.Sucesso) { _erroAlimento = r.Mensagem; return; }
        _erroAlimento = null;
        _consulta = _novo.Nome;
        _novo = new();
        Eventos.MostrarMensagem(r.Mensagem);
        await Consultar();
    }

    private async Task Consultar() =>
        _consultados = _consulta.Trim().Length < 2 ? [] : await Fitness.BuscarAlimentosAsync(_consulta, 25);

    private async Task SalvarMetas()
    {
        await Fitness.SalvarMetasAsync(new MetasFitness(_metas.Kcal, _metas.Proteina, _metas.Carboidrato, _metas.Gordura, _metas.Treinos, Math.Clamp(_metas.Compensacao, 0, 100)));
        Eventos.MostrarMensagem("Metas salvas.");
        await Eventos.NotificarRegistroSalvoAsync();
    }

    // ---------- Texto ----------

    private static string N(double v) => v.ToString("N0", PtBr);

    // Últimos 30 pontos de peso como linha pequena (null com menos de 2 registros).
    private string? Tendencia
    {
        get
        {
            var pts = _pesos?.Pontos.TakeLast(30).ToList();
            if (pts is null || pts.Count < 2) return null;
            var min = pts.Min(p => (double)p.Kg); var max = pts.Max(p => (double)p.Kg);
            var faixa = Math.Max(max - min, 0.5);
            var partes = new List<string>();
            for (var i = 0; i < pts.Count; i++)
            {
                var x = i * 100.0 / (pts.Count - 1);
                var y = 26 - ((double)pts[i].Kg - min) / faixa * 24;
                partes.Add(x.ToString("0.#", CultureInfo.InvariantCulture) + "," + y.ToString("0.#", CultureInfo.InvariantCulture));
            }
            return string.Join(" ", partes);
        }
    }

    private string RotuloCopo => $"Água: {(_dia.AguaMl / 1000.0).ToString("0.0", PtBr)} de {(_dia.MetaAguaMl / 1000.0).ToString("0.0", PtBr)} litros";

    private string AnelTraco
    {
        get
        {
            var f = _dia is null || _dia.MetaKcalDoDia <= 0 ? 0 : Math.Clamp(_dia.Total.Kcal / (double)_dia.MetaKcalDoDia, 0, 1) * 100;
            return $"{f.ToString("0.#", CultureInfo.InvariantCulture)} 100";
        }
    }

    private static string IconeRefeicao(Refeicao r)
    {
        if (r == Refeicao.CafeDaManha) return "cafe";
        if (r == Refeicao.Almoco) return "almoco";
        if (r == Refeicao.Jantar || r == Refeicao.Ceia) return "noite";
        return "lanche";
    }

    private static string Pct(double v, double meta) => meta <= 0 ? "" : $"{v / meta * 100:0}%";

    private static string Largura(double v, double meta) =>
        meta <= 0 ? "0%" : (Math.Clamp(v / meta, 0, 1) * 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    public void Dispose() => Eventos.RegistroSalvo -= Recarregar;
