    private void AlternarRefeicao(Refeicao r)
    {
        if (_abertas.Remove(r)) { if (_adicionando == r) _adicionando = null; }
        else _abertas.Add(r);
    }

    private static string ResumoRefeicao(RefeicaoDia r)
    {
        if (r.Consumido.Count > 0) return r.Consumido.Count == 1 ? "1 item" : $"{r.Consumido.Count} itens";
        if (r.Plano.Count > 0) return r.SeguiuPlano ? "seguiu o plano" : "tem plano";
        return "vazia";
    }
    private bool _mostrarTodas;
