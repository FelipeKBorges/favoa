    private string _consulta = "";
    private IReadOnlyList<AlimentoResumo> _consultados = [];
    private MetasForm _metas = new();

    protected override async Task OnInitializedAsync()
    {
        Eventos.RegistroSalvo += Recarregar;
        await Recarregar();
        var m = _dia!.Metas;
        _metas = new MetasForm { Kcal = m.Kcal, Proteina = m.ProteinaG, Carboidrato = m.CarboidratoG, Gordura = m.GorduraG, Treinos = m.TreinosSemana, Compensacao = m.CompensacaoTreinoPct };
    }

    private DiaDieta? _anterior;
    private IReadOnlyList<AlimentoRecente> _recentes = [];

    private IReadOnlyList<ItemRefeicao>? ItensDoDiaAnterior(Refeicao r) => _anterior?.Refeicoes.FirstOrDefault(x => x.Refeicao == r)?.Consumido;

    private async Task CopiarDoDiaAnterior(Refeicao r) => await Notificar(await Fitness.CopiarRefeicaoAsync(_data.AddDays(-1), _data, r));

    private async Task Recarregar()
    {
        _anterior = await Fitness.ObterDiaDietaAsync(_data.AddDays(-1));
        _recentes = await Fitness.ObterAlimentosRecentesAsync(EventosFavoa.Hoje);
        _dia = await Fitness.ObterDiaDietaAsync(_data);
        _pesos = await Fitness.ObterPesosAsync(90, EventosFavoa.Hoje);
        await InvokeAsync(StateHasChanged);
    }

    private RenderFragment Macro(string nome, double valor, double meta, string unidade = "g") => __builder =>
    {
        <div class="macro">
            <div class="macro__linha"><span>@nome</span><span class="macro__valor">@valor.ToString(unidade == "L" ? "0.0" : "0", PtBr)@(meta > 0 ? $" / {meta.ToString(unidade == "L" ? "0.0" : "0", PtBr)}" : "") @unidade</span></div>
            @if (meta > 0)
            {
                <span class="fatia__barra" aria-hidden="true"><span style="width:@Largura(valor, meta)"></span></span>
                @if (EhHoje && valor < meta && nome == "Proteína")
                {
                    <span class="macro__falta">faltam @((meta - valor).ToString("0", PtBr)) g</span>
                }
            }
        </div>
    };

