<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Roda via dotnet.exe (assinado): o Controle de Aplicativos do Windows bloqueia o .exe gerado. -->
    <UseAppHost>false</UseAppHost>
    <AssemblyName>Favoa.Mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Favoa.Core\Favoa.Core.csproj" />
    <ProjectReference Include="..\Favoa.Data\Favoa.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Favoa.Tests" />
  </ItemGroup>

</Project>
