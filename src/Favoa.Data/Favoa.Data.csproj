<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Favoa.Core\Favoa.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tabela TACO (UNICAMP/NEPA), 4ª edição, via taco-api (MIT). Valores por 100 g. -->
    <EmbeddedResource Include="taco.json" LogicalName="Favoa.Data.taco.json" />
    <!-- IBGE, Tabela de Composição Nutricional dos Alimentos Consumidos no Brasil (POF 2008-2009). Gerado de tabelacompleta.xls. -->
    <EmbeddedResource Include="ibge.json" LogicalName="Favoa.Data.ibge.json" />
    <EmbeddedResource Include="medidas.json" LogicalName="Favoa.Data.medidas.json" />
    <EmbeddedResource Include="preparados.json" LogicalName="Favoa.Data.preparados.json" />
    <EmbeddedResource Include="medidas_taco.json" LogicalName="Favoa.Data.medidas_taco.json" />
  </ItemGroup>

</Project>
